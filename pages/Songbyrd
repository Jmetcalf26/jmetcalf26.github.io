  string(3560) "<div data-contents="true">
<div class="" data-block="true" data-editor="6e3t9" data-offset-key="247ih-0-0">
<div class="public-DraftStyleDefault-block public-DraftStyleDefault-ltr" data-offset-key="247ih-0-0"><span data-offset-key="247ih-0-0">From the moment of their inception, MAE have existed in the cross-sectional spaces of creation. Art and innovation. Intricacy and accessibility. Beauty and chaos. Head and heart. Theirs was a meticulous crafting of soundscapes; painstakingly deliberate and blissfully spontaneous.</span></div>
<div data-offset-key="247ih-0-0"></div>
</div>
<div class="" data-block="true" data-editor="6e3t9" data-offset-key="cgb1g-0-0">
